@model IEnumerable<AuraCinema.Domain.Entities.User>
@{
    ViewData["Title"] = "Quản lý Khách hàng";
}

<div class="mb-4">
    <h2 class="h4 mb-0 text-dark fw-bold">Quản lý Khách hàng</h2>
    <p class="text-muted small mb-0">Quản lý thông tin và trạng thái tài khoản khách hàng</p>
</div>

<div class="ac-card p-4 border-0 shadow-sm mb-4">
    <form method="get" class="row g-3">
        <div class="col-md-8">
            <label class="form-label small fw-bold text-secondary">Tìm kiếm theo mã khách hàng (UserCode)</label>
            <input type="text" name="searchUserCode" class="form-control border-light-subtle shadow-sm" placeholder="Nhập mã khách hàng (Ví dụ: USR-)..." value="@ViewBag.SearchUserCode" />
        </div>
        <div class="col-md-4 d-flex align-items-end">
            <button type="submit" class="btn btn-primary me-2 shadow-sm" style="background-color: #0047AB; border: none;">
                <i class="bi bi-search me-2"></i>Tìm kiếm
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">Xóa bộ lọc</a>
        </div>
    </form>
</div>

<div class="ac-card border-0 shadow-sm overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4">Mã KH</th>
                    <th>Họ và tên</th>
                    <th>Email</th>
                    <th>Số điện thoại</th>
                    <th>Trạng thái</th>
                    <th class="text-end pe-4">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <span class="badge bg-secondary bg-opacity-10 text-secondary border">@item.UserCode</span>
                        </td>
                        <td>
                            <span class="fw-bold text-dark">@item.FullName</span>
                        </td>
                        <td>
                            <span class="text-dark">@item.Email</span>
                        </td>
                        <td>
                            <span class="text-dark">@item.Phone</span>
                        </td>
                        <td>
                            @if (item.Status == "Hoat dong")
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-3">Hoạt động</span>
                            }
                            else
                            {
                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger px-3">Bị khóa</span>
                            }
                        </td>
                        <td class="text-end pe-4">
                            <a asp-action="OrderHistory" asp-route-id="@item.UserID" class="btn btn-sm btn-outline-primary me-1" title="Lịch sử đơn hàng">
                                <i class="bi bi-receipt me-1"></i>Lịch sử mua vé
                            </a>

                            <form asp-action="ToggleStatus" asp-route-id="@item.UserID" asp-route-searchUserCode="@ViewBag.SearchUserCode" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn thay đổi trạng thái hoạt động của tài khoản này không?');">
                                @Html.AntiForgeryToken()
                                @if (item.Status == "Hoat dong")
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Khóa tài khoản">
                                        <i class="bi bi-shield-lock me-1"></i>Khóa
                                    </button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-success" title="Mở khóa tài khoản">
                                        <i class="bi bi-shield-check me-1"></i>Mở khóa
                                    </button>
                                }
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted small">Không tìm thấy khách hàng nào.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    
    @await Html.PartialAsync("_Pagination")
</div>
