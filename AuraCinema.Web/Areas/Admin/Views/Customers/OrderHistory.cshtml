@model IEnumerable<AuraCinema.Domain.Entities.Order>
@{
    var customer = ViewBag.Customer as AuraCinema.Domain.Entities.User;
    ViewData["Title"] = "Lịch sử mua vé — " + customer?.FullName;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 mb-0 text-dark fw-bold">Lịch sử mua vé</h2>
        <p class="text-muted small mb-0">Xem danh sách các giao dịch đặt vé của khách hàng</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
        <i class="bi bi-arrow-left me-2"></i>Quay lại danh sách
    </a>
</div>

<!-- Thẻ thông tin khách hàng -->
@if (customer != null)
{
    <div class="ac-card p-4 border-0 shadow-sm mb-4" style="background: linear-gradient(135deg, #ffffff 0%, #f8fafd 100%);">
        <div class="row g-3">
            <div class="col-md-3 border-end">
                <span class="text-secondary small fw-bold text-uppercase d-block mb-1">Mã khách hàng</span>
                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 fs-6 px-3">@customer.UserCode</span>
            </div>
            <div class="col-md-3 border-end">
                <span class="text-secondary small fw-bold text-uppercase d-block mb-1">Họ và tên</span>
                <span class="fw-bold text-dark fs-5">@customer.FullName</span>
            </div>
            <div class="col-md-3 border-end">
                <span class="text-secondary small fw-bold text-uppercase d-block mb-1">Email</span>
                <span class="text-dark">@customer.Email</span>
            </div>
            <div class="col-md-3">
                <span class="text-secondary small fw-bold text-uppercase d-block mb-1">Số điện thoại</span>
                <span class="text-dark">@customer.Phone</span>
            </div>
        </div>
    </div>
}

<!-- Bảng lịch sử đơn hàng -->
<div class="ac-card border-0 shadow-sm overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4">Mã đơn</th>
                    <th>Ngày tạo</th>
                    <th>Phim & Suất chiếu</th>
                    <th>Phòng</th>
                    <th>Ghế đã đặt</th>
                    <th>Dịch vụ</th>
                    <th>Tổng tiền</th>
                    <th>Trạng thái</th>
                    <th class="text-end pe-4">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <span class="badge bg-secondary bg-opacity-10 text-secondary border">@item.OrderCode</span>
                        </td>
                        <td>
                            <span class="text-dark small">@item.HoldExpiryTime.AddHours(-1).ToString("dd/MM/yyyy HH:mm")</span>
                        </td>
                        <td>
                            <div class="fw-bold text-dark">@item.Showtime.Movie.Title</div>
                            <div class="text-muted extra-small">@item.Showtime.StartTime.ToString("HH:mm - dd/MM/yyyy")</div>
                        </td>
                        <td>
                            <span class="text-dark">@item.Showtime.Room.RoomName</span>
                        </td>
                        <td>
                            @if (item.OrderSeats != null && item.OrderSeats.Any())
                            {
                                var seatNames = string.Join(", ", item.OrderSeats.Select(os => $"{os.Seat.RowLabel}{os.Seat.SeatNumber}"));
                                <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25">@seatNames</span>
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                        <td>
                            @if (item.OrderServices != null && item.OrderServices.Any())
                            {
                                var serviceNames = string.Join(", ", item.OrderServices.Select(os => $"{os.Service.ServiceName} (x{os.Quantity})"));
                                <span class="text-muted small text-truncate d-inline-block" style="max-width: 150px;" title="@serviceNames">@serviceNames</span>
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                        <td>
                            <span class="fw-bold text-primary">@item.FinalAmount.ToString("N0") VNĐ</span>
                        </td>
                        <td>
                            @switch (item.Status)
                            {
                                case "Da thanh toan":
                                case "Đã thanh toán":
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3">Đã thanh toán</span>
                                    break;
                                case "Cho thanh toan":
                                case "Chờ thanh toán":
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3">Chờ thanh toán</span>
                                    break;
                                case "Da huy":
                                case "Đã hủy":
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3">Đã hủy</span>
                                    break;
                                case "Da su dung":
                                case "Đã sử dụng":
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3">Đã sử dụng</span>
                                    break;
                                case "Cần hoàn tiền":
                                    <span class="badge bg-info-subtle text-info border border-info-subtle px-3">Cần hoàn tiền</span>
                                    break;
                                case "Đã hoàn tiền":
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger px-3">Đã hoàn tiền</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3">@item.Status</span>
                                    break;
                            }
                        </td>
                        <td class="text-end pe-4">
                            <a asp-controller="Orders" asp-action="Details" asp-route-id="@item.OrderID" class="btn btn-sm btn-outline-info" title="Xem chi tiết đơn hàng">
                                <i class="bi bi-eye"></i> Chi tiết
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted small">Khách hàng này chưa thực hiện bất kỳ giao dịch nào.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .extra-small { font-size: 0.75rem; }
</style>
