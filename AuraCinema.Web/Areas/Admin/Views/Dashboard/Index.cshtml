@model AuraCinema.Web.Areas.Admin.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Tổng quan";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h4 mb-0 text-dark fw-bold">Thống kê & Báo cáo</h2>
    <div>
        <button class="btn btn-outline-secondary btn-sm bg-white"><i class="bi bi-calendar3 me-2"></i>7 ngày qua</button>
        <button class="btn ac-btn-primary btn-sm ms-2"><i class="bi bi-download me-2"></i>Xuất báo cáo</button>
    </div>
</div>

<!-- KPI Scorecards -->
<div class="row g-4 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="ac-card p-3 d-flex align-items-center border-0 shadow-sm">
            <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-3 me-3">
                <i class="bi bi-currency-dollar fs-4"></i>
            </div>
            <div>
                <p class="text-muted small mb-1">Tổng doanh thu</p>
                <h5 class="fw-bold mb-0 text-dark">@Model.TotalRevenue.ToString("N0")đ</h5>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="ac-card p-3 d-flex align-items-center border-0 shadow-sm">
            <div class="bg-success bg-opacity-10 text-success p-3 rounded-3 me-3">
                <i class="bi bi-ticket-perforated fs-4"></i>
            </div>
            <div>
                <p class="text-muted small mb-1">Vé đã bán</p>
                <h5 class="fw-bold mb-0 text-dark">@Model.TotalTicketsSold.ToString("N0")</h5>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="ac-card p-3 d-flex align-items-center border-0 shadow-sm">
            <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-3 me-3">
                <i class="bi bi-cup-straw fs-4"></i>
            </div>
            <div>
                <p class="text-muted small mb-1">Đơn bắp nước</p>
                <h5 class="fw-bold mb-0 text-dark">@Model.TotalConcessionOrders.ToString("N0")</h5>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="ac-card p-3 d-flex align-items-center border-0 shadow-sm">
            <div class="bg-info bg-opacity-10 text-info p-3 rounded-3 me-3">
                <i class="bi bi-people fs-4"></i>
            </div>
            <div>
                <p class="text-muted small mb-1">Tỷ lệ lấp đầy</p>
                <h5 class="fw-bold mb-0 text-dark">@Model.RoomOccupancyRate%</h5>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row 1 -->
<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="ac-card p-4 h-100 border-0 shadow-sm">
            <h6 class="text-dark fw-bold mb-3">Biến động doanh thu</h6>
            <div style="height: 300px;">
                <canvas id="lineChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="ac-card p-4 h-100 border-0 shadow-sm">
            <h6 class="text-dark fw-bold mb-3">Cơ cấu doanh thu</h6>
            <div style="height: 300px;">
                <canvas id="donutChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row 2 -->
<div class="row g-4 mb-4">
    <div class="col-lg-4">
        <div class="ac-card p-4 h-100 border-0 shadow-sm">
            <h6 class="text-dark fw-bold mb-3">Top 5 Phim thịnh hành</h6>
            <div style="height: 300px;">
                <canvas id="barChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="ac-card p-4 h-100 border-0 shadow-sm">
            <h6 class="text-dark fw-bold mb-3">Lượng khách theo khung giờ</h6>
            <div style="height: 300px;">
                <canvas id="columnChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="ac-card p-4 h-100 border-0 shadow-sm">
            <h6 class="text-dark fw-bold mb-3">Phương thức thanh toán</h6>
            <div style="height: 300px;">
                <canvas id="pieChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row 3 -->
<div class="row g-4">
    <div class="col-lg-12">
        <div class="ac-card p-4 border-0 shadow-sm">
            <h6 class="text-dark fw-bold mb-3">Sử dụng mã khuyến mãi (Phễu chuyển đổi)</h6>
            <div class="d-flex align-items-center justify-content-center" style="height: 200px;">
                <div class="w-75 text-center">
                    <div class="mb-3">
                        <div class="text-muted small mb-1">Tổng số đơn hàng (@Model.PromotionUsage.TotalOrders)</div>
                        <div class="progress" style="height: 30px; border-radius: 15px; background-color: #f0f0f0;">
                            <div class="progress-bar bg-primary" role="progressbar" style="width: 100%">100%</div>
                        </div>
                    </div>
                    <div>
                        @{ 
                            var promoPercent = Model.PromotionUsage.TotalOrders > 0 
                                ? Math.Round((double)Model.PromotionUsage.OrdersWithPromoCode / Model.PromotionUsage.TotalOrders * 100) 
                                : 0; 
                        }
                        <div class="text-muted small mb-1">Sử dụng khuyến mãi (@Model.PromotionUsage.OrdersWithPromoCode)</div>
                        <div class="progress mx-auto" style="height: 30px; border-radius: 15px; background-color: #f0f0f0; width: @(promoPercent < 20 ? 20 : promoPercent)%">
                            <div class="progress-bar bg-info" role="progressbar" style="width: 100%">@promoPercent%</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Global Chart Defaults for Light Theme
        Chart.defaults.color = '#555555';
        Chart.defaults.borderColor = '#eeeeee';

        const chartColors = ['#0047AB', '#0d6efd', '#10b981', '#f59e0b', '#8b5cf6'];

        // 1. Line Chart (Revenue Over Time)
        new Chart(document.getElementById('lineChart'), {
            type: 'line',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.RevenueOverTime.Labels)),
                datasets: [{
                    label: 'Doanh thu (VNĐ)',
                    data: @Html.Raw(Json.Serialize(Model.RevenueOverTime.Data)),
                    borderColor: '#0047AB',
                    backgroundColor: 'rgba(0, 71, 171, 0.05)',
                    tension: 0.4,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } }
            }
        });

        // 2. Donut Chart (Revenue Structure)
        new Chart(document.getElementById('donutChart'), {
            type: 'doughnut',
            data: {
                labels: ['Vé phim', 'Bắp nước'],
                datasets: [{
                    data: [@Model.RevenueStructure.TicketRevenue, @Model.RevenueStructure.ConcessionRevenue],
                    backgroundColor: ['#0047AB', '#0d6efd'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '75%'
            }
        });

        // 3. Horizontal Bar Chart (Top Movies)
        new Chart(document.getElementById('barChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.TopMovies.Labels)),
                datasets: [{
                    label: 'Số vé',
                    data: @Html.Raw(Json.Serialize(Model.TopMovies.Data)),
                    backgroundColor: chartColors,
                    borderRadius: 4
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } }
            }
        });

        // 4. Column Chart (Customers by Time)
        new Chart(document.getElementById('columnChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.CustomersByTime.Labels)),
                datasets: [{
                    label: 'Lượng khách',
                    data: @Html.Raw(Json.Serialize(Model.CustomersByTime.Data)),
                    backgroundColor: '#10b981',
                    borderRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } }
            }
        });

        // 5. Pie Chart (Payment Methods)
        new Chart(document.getElementById('pieChart'), {
            type: 'pie',
            data: {
                labels: ['PayOS', 'Tiền mặt', 'Momo'],
                datasets: [{
                    data: [@Model.PaymentMethods.PayOS, @Model.PaymentMethods.Cash, @Model.PaymentMethods.Momo],
                    backgroundColor: ['#0047AB', '#f59e0b', '#8b5cf6'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false
            }
        });
    </script>
}
