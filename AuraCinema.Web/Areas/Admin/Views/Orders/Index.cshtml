@model IEnumerable<AuraCinema.Domain.Entities.Order>
@{
    ViewData["Title"] = "Danh sách Đơn hàng";
}

<div class="mb-4">
    <h2 class="h4 mb-0 text-dark fw-bold">Quản lý Đơn hàng</h2>
    <p class="text-muted small mb-0">Theo dõi trạng thái đặt vé và doanh thu</p>
</div>

<div class="ac-card border-0 shadow-sm overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4">Mã đơn</th>
                    <th>Khách hàng</th>
                    <th>Phim & Suất chiếu</th>
                    <th>Tổng tiền</th>
                    <th>Trạng thái</th>
                    <th class="text-end pe-4">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <span class="badge bg-secondary bg-opacity-10 text-secondary border">@item.OrderCode</span>
                        </td>
                        <td>
                            <div class="fw-bold">@item.User.FullName</div>
                            <div class="text-muted extra-small">@item.User.Email</div>
                        </td>
                        <td>
                            <div class="fw-bold">@item.Showtime.Movie.Title</div>
                            <div class="text-muted extra-small">@item.Showtime.StartTime.ToString("HH:mm - dd/MM/yyyy")</div>
                        </td>
                        <td>
                            <div class="fw-bold text-dark">@item.FinalAmount.ToString("N0") VNĐ</div>
                        </td>
                        <td>
                            @switch (item.Status)
                            {
                                case "Da thanh toan":
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3">Đã thanh toán</span>
                                    break;
                                case "Cho thanh toan":
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3">Chờ thanh toán</span>
                                    break;
                                case "Da huy":
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3">Đã hủy</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3">@item.Status</span>
                                    break;
                            }
                        </td>
                        <td class="text-end pe-4">
                            <a asp-action="Details" asp-route-id="@item.OrderID" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye me-1"></i>Chi tiết
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .extra-small { font-size: 0.75rem; }
</style>
