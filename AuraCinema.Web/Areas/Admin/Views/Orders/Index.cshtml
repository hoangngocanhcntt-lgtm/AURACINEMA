@model IEnumerable<AuraCinema.Domain.Entities.Order>
@{
    ViewData["Title"] = "Danh sách Đơn hàng";
}

<div class="mb-4">
    <h2 class="h4 mb-0 text-dark fw-bold">Quản lý Đơn hàng</h2>
    <p class="text-muted small mb-0">Theo dõi trạng thái đặt vé và doanh thu</p>
</div>

<div class="ac-card p-4 border-0 shadow-sm mb-4">
    <form method="get" class="row g-3">
        <div class="col-md-4">
            <label class="form-label small fw-bold text-secondary">Lọc theo ngày</label>
            <input type="date" name="searchDate" class="form-control border-light-subtle shadow-sm" value="@ViewBag.SearchDate" />
        </div>
        <div class="col-md-4">
            <label class="form-label small fw-bold text-secondary">Trạng thái</label>
            <select name="searchStatus" class="form-select border-light-subtle shadow-sm">
                <option value="">-- Tất cả trạng thái --</option>
                <option value="Đã thanh toán" selected="@(ViewBag.SearchStatus == "Đã thanh toán")">Đã thanh toán</option>
                <option value="Chờ thanh toán" selected="@(ViewBag.SearchStatus == "Chờ thanh toán")">Chờ thanh toán</option>
                <option value="Đã hủy" selected="@(ViewBag.SearchStatus == "Đã hủy")">Đã hủy</option>
                <option value="Đã sử dụng" selected="@(ViewBag.SearchStatus == "Đã sử dụng")">Đã sử dụng</option>
                <option value="Cần hoàn tiền" selected="@(ViewBag.SearchStatus == "Cần hoàn tiền")">Cần hoàn tiền</option>
                <option value="Đã hoàn tiền" selected="@(ViewBag.SearchStatus == "Đã hoàn tiền")">Đã hoàn tiền</option>
            </select>
        </div>
        <div class="col-md-4 d-flex align-items-end">
            <button type="submit" class="btn btn-primary me-2 shadow-sm" style="background-color: #0047AB; border: none;"><i class="bi bi-search me-2"></i>Tìm kiếm</button>
            <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">Xóa bộ lọc</a>
        </div>
    </form>
</div>

<div class="ac-card border-0 shadow-sm overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4">Mã đơn</th>
                    <th>Khách hàng</th>
                    <th>Phim & Suất chiếu</th>
                    <th>Tổng tiền</th>
                    <th>Trạng thái</th>
                    <th class="text-end pe-4">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <span class="badge bg-secondary bg-opacity-10 text-secondary border">@item.OrderCode</span>
                        </td>
                        <td>
                            <div class="fw-bold">@item.User.FullName</div>
                            <div class="text-muted extra-small">@item.User.Email</div>
                        </td>
                        <td>
                            <div class="fw-bold">@item.Showtime.Movie.Title</div>
                            <div class="text-muted extra-small">@item.Showtime.StartTime.ToString("HH:mm - dd/MM/yyyy")</div>
                        </td>
                        <td>
                            <div class="fw-bold text-dark">@item.FinalAmount.ToString("N0") VNĐ</div>
                        </td>
                        <td>
                            @switch (item.Status)
                            {
                                case "Da thanh toan":
                                case "Đã thanh toán":
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3">Đã thanh toán</span>
                                    break;
                                case "Cho thanh toan":
                                case "Chờ thanh toán":
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3">Chờ thanh toán</span>
                                    break;
                                case "Da huy":
                                case "Đã hủy":
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3">Đã hủy</span>
                                    break;
                                case "Da su dung":
                                case "Đã sử dụng":
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3">Đã sử dụng</span>
                                    break;
                                case "Cần hoàn tiền":
                                    <span class="badge bg-info-subtle text-info border border-info-subtle px-3">Cần hoàn tiền</span>
                                    break;
                                case "Đã hoàn tiền":
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger px-3">Đã hoàn tiền</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3">@item.Status</span>
                                    break;
                            }
                        </td>
                        <td class="text-end pe-4">
                            <a asp-action="Details" asp-route-id="@item.OrderID" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye me-1"></i>Chi tiết
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    
    @await Html.PartialAsync("_Pagination")
</div>

<style>
    .extra-small { font-size: 0.75rem; }
</style>
