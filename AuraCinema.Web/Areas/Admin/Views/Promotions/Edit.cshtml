@model AuraCinema.Web.Areas.Admin.ViewModels.PromotionFormViewModel
@{
    ViewData["Title"] = "Chỉnh sửa khuyến mãi";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-link text-decoration-none p-0 text-secondary mb-2">
        <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
    </a>
    <h2 class="h4 mb-0 text-dark fw-bold">Chỉnh sửa Khuyến mãi</h2>
</div>

<div class="row">
    <div class="col-xl-6 col-lg-8">
        <div class="ac-card p-4 shadow-sm border-0">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="PromoID" />
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="PromoCode" class="form-label text-secondary small fw-bold"></label>
                    <input asp-for="PromoCode" class="form-control border-light-subtle shadow-sm bg-light" readonly />
                </div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label text-secondary small fw-bold"></label>
                    <input asp-for="Title" class="form-control border-light-subtle shadow-sm" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DiscountValue" class="form-label text-secondary small fw-bold"></label>
                    <div class="input-group">
                        <input asp-for="DiscountValue" class="form-control border-light-subtle shadow-sm" type="number" />
                        <span class="input-group-text border-light-subtle shadow-sm bg-light">VNĐ</span>
                    </div>
                    <span asp-validation-for="DiscountValue" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MinAmount" class="form-label text-secondary small fw-bold"></label>
                    <div class="input-group">
                        <input asp-for="MinAmount" class="form-control border-light-subtle shadow-sm" type="number" min="0" />
                        <span class="input-group-text border-light-subtle shadow-sm bg-light">VNĐ</span>
                    </div>
                    <span asp-validation-for="MinAmount" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Condition" class="form-label text-secondary small fw-bold"></label>
                    <textarea asp-for="Condition" class="form-control border-light-subtle shadow-sm" rows="2"></textarea>
                    <span asp-validation-for="Condition" class="text-danger small"></span>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="StartDate" class="form-label text-secondary small fw-bold"></label>
                        <input asp-for="StartDate" class="form-control border-light-subtle shadow-sm" type="datetime-local" />
                        <span asp-validation-for="StartDate" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="EndDate" class="form-label text-secondary small fw-bold"></label>
                        <input asp-for="EndDate" class="form-control border-light-subtle shadow-sm" type="datetime-local" />
                        <span asp-validation-for="EndDate" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Status" class="form-label text-secondary small fw-bold"></label>
                    <select asp-for="Status" class="form-select border-light-subtle shadow-sm">
                        <option value="Hoat dong">Hoạt động</option>
                        <option value="Het han">Hết hạn/Đóng</option>
                    </select>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-save me-2"></i>Cập nhật
                    </button>
                    <a asp-action="Index" class="btn btn-light px-4">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>
