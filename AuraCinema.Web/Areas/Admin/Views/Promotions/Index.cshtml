@model IEnumerable<AuraCinema.Domain.Entities.Promotion>
@{
    ViewData["Title"] = "Quản lý Khuyến mãi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 mb-0 text-dark fw-bold">Chương trình Khuyến mãi</h2>
        <p class="text-muted small mb-0">Thiết lập các mã giảm giá và ưu đãi cho khách hàng</p>
    </div>
    <a asp-action="Create" class="btn btn-primary px-4 shadow-sm">
        <i class="bi bi-plus-lg me-2"></i>Thêm khuyến mãi
    </a>
</div>

<div class="ac-card p-4 border-0 shadow-sm mb-4">
    <form method="get" class="row g-3">
        <div class="col-md-8">
            <input type="text" name="searchCode" class="form-control border-light-subtle shadow-sm" placeholder="Tìm kiếm theo Mã khuyến mãi..." value="@ViewBag.SearchCode" />
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-primary me-2 shadow-sm" style="background-color: #0047AB; border: none;"><i class="bi bi-search me-2"></i>Tìm kiếm</button>
            <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">Xóa bộ lọc</a>
        </div>
    </form>
</div>

<div class="ac-card border-0 shadow-sm overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4">Mã</th>
                    <th>Tiêu đề</th>
                    <th>Mức giảm</th>
                    <th>Thời hạn</th>
                    <th style="white-space:nowrap;min-width:100px;">Trạng thái</th>
                    <th class="text-end pe-4" style="white-space:nowrap;min-width:100px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <span class="badge bg-secondary bg-opacity-10 text-secondary border">@item.PromoCode</span>
                        </td>
                        <td>
                            <div class="fw-bold">@item.Title</div>
                            <div class="text-muted extra-small">@item.Condition</div>
                        </td>
                        <td>
                            <span class="text-success fw-bold">-@item.DiscountValue.ToString("N0") VNĐ</span>
                        </td>
                        <td>
                            <div class="small">@item.StartDate.ToString("dd/MM/yy") - @item.EndDate.ToString("dd/MM/yy")</div>
                        </td>
                        <td style="white-space:nowrap;">
                            @if (item.Status == "Hoat dong")
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-3">Hoạt động</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3">Hết hạn/Đóng</span>
                            }
                        </td>
                        <td class="text-end pe-4" style="white-space:nowrap;">
                            <div class="d-flex flex-nowrap justify-content-end gap-1">
                                <a asp-action="Edit" asp-route-id="@item.PromoID" class="btn btn-sm btn-outline-secondary" title="Sửa">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.PromoID" method="post" 
                                      onsubmit="return confirm('Bạn có chắc chắn muốn XÓA chương trình này?');" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    
    @await Html.PartialAsync("_Pagination")
</div>

<style>
    .extra-small { font-size: 0.75rem; }
</style>
