@model AuraCinema.Web.Areas.Admin.ViewModels.RoomFormViewModel
@{
    ViewData["Title"] = "Chỉnh sửa phòng chiếu";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-link text-decoration-none p-0 text-secondary mb-2">
        <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
    </a>
    <h2 class="h4 mb-0 text-dark fw-bold">Chỉnh sửa Phòng chiếu</h2>
</div>

<div class="row">
    <div class="col-xl-6 col-lg-8">
        <div class="ac-card p-4 shadow-sm border-0">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="RoomID" />
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="RoomCode" class="form-label text-secondary small fw-bold"></label>
                    <input value="@Model.RoomCode" class="form-control border-light-subtle shadow-sm bg-light" disabled="disabled" style="pointer-events:none;" />
                    <input type="hidden" asp-for="RoomCode" />
                </div>

                <div class="mb-3">
                    <label asp-for="RoomName" class="form-label text-secondary small fw-bold"></label>
                    <input asp-for="RoomName" class="form-control border-light-subtle shadow-sm" />
                    <span asp-validation-for="RoomName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Capacity" class="form-label text-secondary small fw-bold"></label>
                    <input asp-for="Capacity" class="form-control border-light-subtle shadow-sm" type="number" />
                    <span asp-validation-for="Capacity" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Status" class="form-label text-secondary small fw-bold"></label>
                    <select asp-for="Status" class="form-select border-light-subtle shadow-sm">
                        <option value="Hoat dong">Hoạt động</option>
                        <option value="Ngung hoat dong">Ngừng hoạt động</option>
                    </select>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-save me-2"></i>Cập nhật
                    </button>
                    <a asp-action="Index" class="btn btn-light px-4">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>
