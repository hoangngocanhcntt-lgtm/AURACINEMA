@model IEnumerable<AuraCinema.Domain.Entities.Room>
@{
    ViewData["Title"] = "Quản lý Phòng chiếu";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 mb-0 text-dark fw-bold">Danh sách Phòng chiếu</h2>
        <p class="text-secondary small mb-0">Quản lý các phòng chiếu phim trong hệ thống</p>
    </div>
    <a asp-action="Create" class="btn btn-primary px-4 shadow-sm">
        <i class="bi bi-plus-lg me-2"></i>Thêm phòng mới
    </a>
</div>

<div class="ac-card border-0 shadow-sm overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4 text-dark">Mã phòng</th>
                    <th class="text-dark">Tên phòng</th>
                    <th class="text-dark">Sức chứa</th>
                    <th class="text-dark">Trạng thái</th>
                    <th class="text-end pe-4 text-dark">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <span class="badge bg-secondary bg-opacity-10 text-secondary border">@item.RoomCode</span>
                        </td>
                        <td>@item.RoomName</td>
                        <td>
                            <span class="badge bg-info-subtle text-info border border-info-subtle">
                                <i class="bi bi-people me-1"></i>@item.Capacity ghế
                            </span>
                        </td>
                        <td>
                            @if (item.Status == "Hoat dong")
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-3">Hoạt động</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3">Ngừng hoạt động</span>
                            }
                        </td>
                        <td class="text-end pe-4">
                            <div class="btn-group">
                                <form asp-action="GenerateSeats" asp-route-id="@item.RoomID" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-info" title="Cấp sơ đồ ghế">
                                        <i class="bi bi-magic"></i>
                                    </button>
                                </form>
                                <a asp-controller="Seats" asp-action="Room" asp-route-id="@item.RoomID" class="btn btn-sm btn-outline-primary" title="Quản lý ghế">
                                    <i class="bi bi-grid-3x3-gap"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.RoomID" class="btn btn-sm btn-outline-secondary" title="Sửa">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                @if (item.Status == "Hoat dong")
                                {
                                    <form asp-action="Delete" asp-route-id="@item.RoomID" method="post" 
                                          onsubmit="return confirm('Bạn có chắc chắn muốn ngừng hoạt động phòng này?');" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Ngừng hoạt động">
                                            <i class="bi bi-x-circle"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="Activate" asp-route-id="@item.RoomID" method="post" 
                                          onsubmit="return confirm('Bạn có chắc chắn muốn mở hoạt động lại phòng này?');" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-success" title="Hoạt động lại">
                                            <i class="bi bi-check-circle"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    
    @await Html.PartialAsync("_Pagination")
</div>
