@model IEnumerable<AuraCinema.Domain.Entities.Service>
@{
    ViewData["Title"] = "Quản lý Dịch vụ & Đồ ăn";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 mb-0 text-dark fw-bold">Dịch vụ & Đồ ăn</h2>
        <p class="text-muted small mb-0">Quản lý thực đơn bắp nước và các dịch vụ đi kèm</p>
    </div>
    <a asp-action="Create" class="btn btn-primary px-4 shadow-sm">
        <i class="bi bi-plus-lg me-2"></i>Thêm dịch vụ
    </a>
</div>

<div class="ac-card border-0 shadow-sm overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4">Hình ảnh</th>
                    <th>Mã dịch vụ</th>
                    <th>Tên dịch vụ</th>
                    <th>Giá</th>
                    <th>Trạng thái</th>
                    <th class="text-end pe-4">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <img src="@item.Image" alt="@item.ServiceName" class="rounded shadow-sm" style="width: 50px; height: 50px; object-fit: cover;" onerror="this.src='/images/popcorn-default.jpg'" />
                        </td>
                        <td>
                            <span class="badge bg-secondary bg-opacity-10 text-secondary border">@item.ServiceCode</span>
                        </td>
                        <td>
                            <div class="fw-bold">@item.ServiceName</div>
                        </td>
                        <td>
                            <span class="text-dark fw-bold">@item.Price.ToString("N0") VNĐ</span>
                        </td>
                        <td>
                            @if (item.Status == "Hoat dong")
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-3">Đang bán</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3">Ngừng bán</span>
                            }
                        </td>
                        <td class="text-end pe-4">
                            <div class="btn-group">
                                <a asp-action="Edit" asp-route-id="@item.ServiceID" class="btn btn-sm btn-outline-secondary" title="Sửa">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.ServiceID" method="post" 
                                      onsubmit="return confirm('Bạn có chắc chắn muốn ngừng kinh doanh dịch vụ này?');" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Ngừng bán">
                                        <i class="bi bi-slash-circle"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
