@model AuraCinema.Web.Areas.Admin.ViewModels.ShowtimeFormViewModel
@{
    ViewData["Title"] = "Chỉnh sửa suất chiếu";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-link text-decoration-none p-0 text-secondary mb-2">
        <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
    </a>
    <h2 class="h4 mb-0 text-dark fw-bold">Chỉnh sửa Suất chiếu</h2>
</div>

<div class="row">
    <div class="col-xl-6 col-lg-8">
        <div class="ac-card p-4 shadow-sm border-0">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ShowtimeID" />
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="ShowtimeCode" class="form-label text-secondary small fw-bold"></label>
                    <input asp-for="ShowtimeCode" class="form-control border-light-subtle shadow-sm bg-light" readonly />
                </div>

                <div class="mb-3">
                    <label asp-for="MovieID" class="form-label text-secondary small fw-bold"></label>
                    <select asp-for="MovieID" asp-items="Model.MovieList" class="form-select border-light-subtle shadow-sm">
                    </select>
                    <span asp-validation-for="MovieID" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="RoomID" class="form-label text-secondary small fw-bold"></label>
                    <select asp-for="RoomID" asp-items="Model.RoomList" class="form-select border-light-subtle shadow-sm">
                    </select>
                    <span asp-validation-for="RoomID" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="StartTime" class="form-label text-secondary small fw-bold"></label>
                    <input asp-for="StartTime" class="form-control border-light-subtle shadow-sm" type="datetime-local" />
                    <span asp-validation-for="StartTime" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Status" class="form-label text-secondary small fw-bold"></label>
                    <select asp-for="Status" class="form-select border-light-subtle shadow-sm">
                        <option value="Sap chieu">Sắp chiếu</option>
                        <option value="Dang chieu">Đang chiếu</option>
                        <option value="Da ket thuc">Đã kết thúc</option>
                        <option value="Da huy">Đã hủy</option>
                    </select>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-save me-2"></i>Cập nhật
                    </button>
                    <a asp-action="Index" class="btn btn-light px-4">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>
