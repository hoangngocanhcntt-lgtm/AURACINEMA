@model IEnumerable<AuraCinema.Domain.Entities.Showtime>
@{
    ViewData["Title"] = "Quản lý Suất chiếu";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 mb-0 text-dark fw-bold">Lịch chiếu phim</h2>
        <p class="text-muted small mb-0">Điều phối các suất chiếu theo phim và phòng</p>
    </div>
    <a asp-action="Create" class="btn btn-primary px-4 shadow-sm">
        <i class="bi bi-plus-lg me-2"></i>Thêm suất chiếu
    </a>
</div>

<div class="ac-card border-0 shadow-sm overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4">Mã suất</th>
                    <th>Phim</th>
                    <th>Phòng</th>
                    <th>Thời gian bắt đầu</th>
                    <th>Trạng thái</th>
                    <th class="text-end pe-4">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <span class="badge bg-secondary bg-opacity-10 text-secondary border">@item.ShowtimeCode</span>
                        </td>
                        <td>
                            <div class="fw-bold">@item.Movie.Title</div>
                            <div class="text-muted extra-small">@item.Movie.Genre</div>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">@item.Room.RoomName</span>
                        </td>
                        <td>
                            <div>@item.StartTime.ToString("dd/MM/yyyy")</div>
                            <div class="fw-bold text-dark">@item.StartTime.ToString("HH:mm")</div>
                        </td>
                        <td>
                            @switch (item.Status)
                            {
                                case "Sap chieu":
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3">Sắp chiếu</span>
                                    break;
                                case "Dang chieu":
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3">Đang chiếu</span>
                                    break;
                                case "Da ket thuc":
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3">Đã kết thúc</span>
                                    break;
                                case "Da huy":
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3">Đã hủy</span>
                                    break;
                            }
                        </td>
                        <td class="text-end pe-4">
                            <div class="btn-group">
                                <a asp-action="Edit" asp-route-id="@item.ShowtimeID" class="btn btn-sm btn-outline-secondary" title="Sửa">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.ShowtimeID" method="post" 
                                      onsubmit="return confirm('Bạn có chắc chắn muốn hủy suất chiếu này?');" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Hủy suất">
                                        <i class="bi bi-x-circle"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .extra-small { font-size: 0.75rem; }
</style>
