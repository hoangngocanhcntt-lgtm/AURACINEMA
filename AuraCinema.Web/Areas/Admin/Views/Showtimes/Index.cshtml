@model IEnumerable<AuraCinema.Domain.Entities.Showtime>
@{
    ViewData["Title"] = "Quản lý Suất chiếu";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 mb-0 text-dark fw-bold">Lịch chiếu phim</h2>
        <p class="text-muted small mb-0">Điều phối các suất chiếu theo phim và phòng</p>
    </div>
    <a asp-action="Create" class="btn btn-primary px-4 shadow-sm">
        <i class="bi bi-plus-lg me-2"></i>Thêm suất chiếu
    </a>
</div>

<div class="ac-card p-4 border-0 shadow-sm mb-4">
    <form method="get" class="row g-3">
        <div class="col-md-3">
            <label class="form-label small fw-bold text-secondary">Mã suất chiếu</label>
            <input type="text" name="searchCode" class="form-control border-light-subtle shadow-sm" placeholder="Mã..." value="@ViewBag.SearchCode" />
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-bold text-secondary">Ngày chiếu</label>
            <input type="date" name="searchDate" class="form-control border-light-subtle shadow-sm" value="@ViewBag.SearchDate" />
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-bold text-secondary">Phòng chiếu</label>
            <select name="roomId" asp-items="@(new SelectList(ViewBag.RoomList, "Value", "Text", ViewBag.SelectedRoomId))" class="form-select border-light-subtle shadow-sm">
                <option value="">-- Tất cả --</option>
            </select>
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <button type="submit" class="btn btn-primary me-2 shadow-sm flex-grow-1" style="background-color: #0047AB; border: none;"><i class="bi bi-search me-2"></i>Tìm kiếm</button>
            <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">Xóa</a>
        </div>
    </form>
</div>

<div class="ac-card border-0 shadow-sm overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4">Mã suất</th>
                    <th>Phim</th>
                    <th>Phòng</th>
                    <th>Thời gian</th>
                    <th style="white-space:nowrap;min-width:120px;">Trạng thái</th>
                    <th class="text-end pe-4" style="white-space:nowrap;min-width:100px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <span class="badge bg-secondary bg-opacity-10 text-secondary border">@item.ShowtimeCode</span>
                        </td>
                        <td>
                            <div class="fw-bold">@item.Movie.Title</div>
                            <div class="text-muted extra-small">@item.Movie.Genre</div>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">@item.Room.RoomName</span>
                        </td>
                        <td>
                            <div class="small text-muted">@item.StartTime.ToString("dd/MM/yyyy")</div>
                            <div class="fw-bold text-dark">
                                <i class="bi bi-clock me-1 text-primary"></i>@item.StartTime.ToString("HH:mm") 
                                <span class="mx-1 text-muted"><i class="bi bi-arrow-right"></i></span> 
                                <i class="bi bi-clock-fill me-1 text-secondary"></i>@item.EndTime.ToString("HH:mm")
                            </div>
                        </td>
                        <td style="white-space:nowrap;">
                            @switch (item.Status)
                            {
                                case "Đã lên lịch":
                                    <span class="badge bg-info-subtle text-info border border-info-subtle px-3">Đã lên lịch</span>
                                    break;
                                case "Đang mở bán":
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3">Đang mở bán</span>
                                    break;
                                case "Đang chiếu":
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3"><i class="bi bi-broadcast me-1"></i>Đang chiếu</span>
                                    break;
                                case "Đã kết thúc":
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3">Đã kết thúc</span>
                                    break;
                                case "Đã hủy":
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3">Đã hủy</span>
                                    break;
                                default:
                                    <span class="badge bg-light text-dark border px-3">@item.Status</span>
                                    break;
                            }
                        </td>
                        <td class="text-end pe-4" style="white-space:nowrap;">
                            <div class="d-flex flex-nowrap justify-content-end gap-1">
                                @if (item.Status != "Đang mở bán" && item.Status != "Đang chiếu")
                                {
                                    <a asp-action="Edit" asp-route-id="@item.ShowtimeID" class="btn btn-sm btn-outline-secondary" title="Sửa">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.ShowtimeID" method="post" 
                                          onsubmit="return confirm('Bạn có chắc chắn muốn XÓA suất chiếu này?');" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    
    @await Html.PartialAsync("_Pagination")
</div>

<style>
    .extra-small { font-size: 0.75rem; }
</style>
