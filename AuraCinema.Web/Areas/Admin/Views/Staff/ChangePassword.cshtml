@model AuraCinema.Web.Areas.Admin.ViewModels.StaffChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu nhân viên";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 mb-0 text-dark fw-bold">Đổi mật khẩu nhân viên</h2>
        <p class="text-muted small mb-0">Cập nhật mật khẩu mới cho nhân viên: <strong class="text-dark">@Model.FullName</strong></p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
        <i class="bi bi-arrow-left me-2"></i>Quay lại danh sách
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="ac-card p-5 border-0 shadow-sm">
            <form asp-action="ChangePassword" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="UserID" />
                <input type="hidden" asp-for="FullName" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4 rounded-3 border-0"></div>

                <div class="mb-4">
                    <label class="form-label fw-bold text-secondary">Tên nhân viên</label>
                    <input class="form-control bg-light border-light-subtle p-3" value="@Model.FullName" disabled />
                </div>

                <div class="mb-4">
                    <label asp-for="NewPassword" class="form-label fw-bold text-secondary"></label>
                    <input asp-for="NewPassword" type="password" class="form-control border-light-subtle shadow-sm p-3" placeholder="Nhập mật khẩu mới..." />
                    <span asp-validation-for="NewPassword" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmNewPassword" class="form-label fw-bold text-secondary"></label>
                    <input asp-for="ConfirmNewPassword" type="password" class="form-control border-light-subtle shadow-sm p-3" placeholder="Xác nhận mật khẩu mới..." />
                    <span asp-validation-for="ConfirmNewPassword" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mt-5 text-end border-top pt-4">
                    <button type="submit" class="btn ac-btn-primary px-5 py-2.5 shadow-sm">
                        <i class="bi bi-key me-2"></i>Đổi mật khẩu
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
