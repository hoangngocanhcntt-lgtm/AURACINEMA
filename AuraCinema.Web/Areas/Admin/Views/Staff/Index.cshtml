@model IEnumerable<AuraCinema.Domain.Entities.User>
@{
    ViewData["Title"] = "Quản lý Nhân viên";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 mb-0 text-dark fw-bold">Quản lý Nhân viên</h2>
        <p class="text-muted small mb-0">Quản lý danh sách, thêm mới và phân quyền tài khoản nhân viên</p>
    </div>
    <a asp-action="Create" class="btn ac-btn-primary shadow-sm">
        <i class="bi bi-plus-lg me-2"></i>Thêm nhân viên mới
    </a>
</div>

<div class="ac-card border-0 shadow-sm overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4">Mã NV</th>
                    <th>Họ và tên</th>
                    <th>Email</th>
                    <th>Số điện thoại</th>
                    <th style="white-space:nowrap;min-width:100px;">Trạng thái</th>
                    <th class="text-end pe-4" style="white-space:nowrap;min-width:220px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <span class="badge bg-secondary bg-opacity-10 text-secondary border">@item.UserCode</span>
                        </td>
                        <td>
                            <span class="fw-bold text-dark">@item.FullName</span>
                        </td>
                        <td>
                            <span class="text-dark">@item.Email</span>
                        </td>
                        <td>
                            <span class="text-dark">@item.Phone</span>
                        </td>
                        <td style="white-space:nowrap;">
                            @if (item.Status == "Hoat dong")
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-3">Hoạt động</span>
                            }
                            else
                            {
                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger px-3">Bị khóa</span>
                            }
                        </td>
                        <td class="text-end pe-4" style="white-space:nowrap;">
                            <div class="d-flex flex-nowrap justify-content-end gap-1">
                                <a asp-action="ChangePassword" asp-route-id="@item.UserID" class="btn btn-sm btn-outline-warning" title="Đổi mật khẩu">
                                    <i class="bi bi-key me-1"></i>Đổi mật khẩu
                                </a>
                                <form asp-action="ToggleStatus" asp-route-id="@item.UserID" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn thay đổi trạng thái?');">
                                    @Html.AntiForgeryToken()
                                    @if (item.Status == "Hoat dong")
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Khóa">
                                            <i class="bi bi-shield-lock me-1"></i>Khóa
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-success" title="Mở khóa">
                                            <i class="bi bi-shield-check me-1"></i>Mở khóa
                                        </button>
                                    }
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted small">Không tìm thấy nhân viên nào.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    
    @await Html.PartialAsync("_Pagination")
</div>
