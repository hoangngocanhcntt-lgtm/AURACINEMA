@{
    ViewData["Title"] = "Quét mã QR";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="h4 mb-0 text-dark fw-bold">Check-in Vé (QR Code)</h2>
        </div>

        <div class="ac-card p-4 text-center border-0 shadow-sm">
            <div id="reader-container" class="mb-4 bg-light rounded overflow-hidden position-relative" style="min-height: 300px; border: 2px dashed #dee2e6;">
                <div id="reader" style="width: 100%;"></div>
            </div>

            <!-- Custom Status Alert -->
            <div id="scanResult" class="alert d-none shadow-sm" role="alert" style="transition: all 0.3s;">
                <h5 id="resultTitle" class="alert-heading fw-bold mb-1"></h5>
                <p id="resultMessage" class="mb-0"></p>
                <hr id="resultDivider" class="d-none">
                <div id="resultInfo" class="text-start small fw-bold d-none"></div>
            </div>

            <p class="text-muted small mt-4 mb-0">Sử dụng Camera của thiết bị để quét mã QR Code trên ứng dụng của khách hàng.</p>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script src="https://unpkg.com/html5-qrcode"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            let html5QrcodeScanner = new Html5QrcodeScanner(
                "reader",
                { fps: 10, qrbox: {width: 250, height: 250} },
                false);

            let isProcessing = false;

            function onScanSuccess(decodedText, decodedResult) {
                if (isProcessing) return; // Prevent double scanning
                isProcessing = true;
                
                // Show processing UI
                html5QrcodeScanner.pause();
                showResult('info', 'Đang xử lý...', `Mã: ${decodedText}`);

                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

                fetch('@Url.Action("ProcessScan", "TicketScanner", new { area = "Admin" })', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({ QrCodeData: decodedText })
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        showResult('success', 'THÀNH CÔNG', data.message, data.orderInfo);
                    } else {
                        showResult('danger', 'CẢNH BÁO', data.message, data.orderInfo);
                    }
                    
                    // Resume scanning after 3 seconds
                    setTimeout(() => {
                        hideResult();
                        html5QrcodeScanner.resume();
                        isProcessing = false;
                    }, 3000);
                })
                .catch(err => {
                    showResult('danger', 'LỖI MẠNG', 'Không thể kết nối đến máy chủ.');
                    setTimeout(() => {
                        hideResult();
                        html5QrcodeScanner.resume();
                        isProcessing = false;
                    }, 3000);
                });
            }

            function onScanFailure(error) {
                // handle scan failure
            }

            html5QrcodeScanner.render(onScanSuccess, onScanFailure);

            function showResult(type, title, message, info = null) {
                const alertBox = document.getElementById('scanResult');
                const titleEl = document.getElementById('resultTitle');
                const msgEl = document.getElementById('resultMessage');
                const infoEl = document.getElementById('resultInfo');
                const divEl = document.getElementById('resultDivider');

                // Reset classes
                alertBox.className = `alert alert-${type} shadow-sm border-0`;
                alertBox.classList.remove('d-none');
                titleEl.innerText = title;
                msgEl.innerText = message;

                if (info) {
                    divEl.classList.remove('d-none');
                    infoEl.classList.remove('d-none');
                    let html = `Mã đơn: #${info.id}<br/>Phim: ${info.movie}<br/>Khách hàng: ${info.customer}`;
                    if (info.printUrl) {
                        html += `<div class="mt-3"><a href="${info.printUrl}" target="_blank" class="btn btn-primary btn-sm"><i class="bi bi-printer me-2"></i>In Vé</a></div>`;
                    }
                    infoEl.innerHTML = html;
                } else {
                    divEl.classList.add('d-none');
                    infoEl.classList.add('d-none');
                }
            }

            function hideResult() {
                document.getElementById('scanResult').classList.add('d-none');
            }
        });
    </script>
}
