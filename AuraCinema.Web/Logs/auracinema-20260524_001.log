SELECT TOP(@__p_1) [m].[MovieID] AS [movieId], [m].[Title] AS [title], [m].[Genre] AS [genre], [m].[Duration] AS [duration], [m].[ReleaseDate] AS [releaseDate], [m].[Poster] AS [poster], [m].[Status] AS [status], CASE
