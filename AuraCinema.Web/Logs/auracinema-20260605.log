SELECT [m].[MovieID], [m].[Title], [m].[Genre], [m].[Poster], [m].[Duration], [m].[Status], [m].[ReleaseDate], [m].[Director], CASE
    WHEN EXISTS (
        SELECT 1
        FROM [Showtimes] AS [s]
        WHERE [m].[MovieID] = [s].[MovieID] AND [s].[StartTime] > GETDATE()) THEN CAST(1 AS bit)
    ELSE CAST(0 AS bit)
END AS [HasEarlyTickets]
FROM [Movies] AS [m]
