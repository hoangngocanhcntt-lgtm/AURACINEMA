@model AuraCinema.Web.ViewModels.Account.ForgotPasswordViewModel
@{ ViewData["Title"] = "Quên mật khẩu"; Layout = "~/Views/Shared/_Layout.cshtml"; }

<div class="ac-auth-wrapper">
    <div class="ac-auth-card">
        <div class="ac-auth-logo">
            <div style="font-size:2.5rem;">🔑</div>
            <h1 class="ac-auth-title mt-2">Quên mật khẩu?</h1>
            <p class="ac-auth-subtitle">Nhập email để nhận mã OTP xác thực</p>
        </div>
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
        <form asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-4">
                <label asp-for="Email" class="ac-form-label">
                    <i class="bi bi-envelope me-1 text-primary-ac"></i>Email đã đăng ký
                </label>
                <input asp-for="Email" type="email" class="form-control ac-form-control"
                       placeholder="email@example.com" autofocus />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>
            <button type="submit" class="ac-btn-primary w-100 justify-content-center py-3 rounded-3">
                <i class="bi bi-send"></i>Gửi mã OTP
            </button>
        </form>
        <p class="text-center mt-4 mb-0" style="color:var(--ac-muted);font-size:0.9rem;">
            <a asp-action="Login" class="text-primary-ac text-decoration-none">
                <i class="bi bi-arrow-left me-1"></i>Quay lại đăng nhập
            </a>
        </p>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
