@model AuraCinema.Web.ViewModels.Account.ResetPasswordViewModel
@{ ViewData["Title"] = "Đặt mật khẩu mới"; Layout = "~/Views/Shared/_Layout.cshtml"; }

<div class="ac-auth-wrapper">
    <div class="ac-auth-card">
        <div class="ac-auth-logo">
            <div style="font-size:2.5rem;"><i class="bi bi-shield-lock"></i></div>
            <h1 class="ac-auth-title mt-2">Đặt mật khẩu mới</h1>
            <p class="ac-auth-subtitle">Mật khẩu mới tối thiểu 6 ký tự</p>
        </div>
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
        <form asp-action="ResetPassword" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Email" />
            <div class="mb-3">
                <label asp-for="NewPassword" class="ac-form-label">
                    <i class="bi bi-lock me-1 text-primary-ac"></i>Mật khẩu mới
                </label>
                <input asp-for="NewPassword" type="password"
                       class="form-control ac-form-control"
                       placeholder="Tối thiểu 6 ký tự" autofocus />
                <span asp-validation-for="NewPassword" class="field-validation-error"></span>
            </div>
            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="ac-form-label">
                    <i class="bi bi-lock-fill me-1 text-primary-ac"></i>Xác nhận mật khẩu
                </label>
                <input asp-for="ConfirmPassword" type="password"
                       class="form-control ac-form-control"
                       placeholder="Nhập lại mật khẩu mới" />
                <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
            </div>
            <button type="submit" class="ac-btn-primary w-100 justify-content-center py-3 rounded-3">
                <i class="bi bi-shield-check"></i>Cập nhật mật khẩu
            </button>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
