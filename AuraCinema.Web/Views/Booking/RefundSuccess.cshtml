@model AuraCinema.Domain.Entities.Order
@{
    ViewData["Title"] = "Hoàn tiền thành công";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container pt-5 pb-5 text-center">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="ac-card p-5 shadow-lg border-0 rounded-4" style="background: linear-gradient(145deg, #1a1a1a, #0d0d0d);">
                <div class="mb-4">
                    <div class="display-1 text-success mb-3">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                    <h2 class="fw-bold  mb-2">Hoàn tiền thành công!</h2>
                    <p class="text-muted">Chúng tôi đã xử lý lệnh hoàn tiền cho đơn hàng của bạn.</p>
                </div>

                <div class="bg-light p-4 rounded-3 text-start mb-4 border border-light">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted small">Mã đơn hàng:</span>
                        <span class=" fw-bold">#@Model.OrderCode</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted small">Số tiền đã hoàn:</span>
                        <span class="text-success fw-bold">@Model.TotalAmount.ToString("N0") VNĐ</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted small">Trạng thái:</span>
                        <span class="badge bg-success bg-opacity-10 text-success">@Model.Status</span>
                    </div>
                    <hr class="border-light">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted small">Ngân hàng:</span>
                        <span class=" small">@Model.RefundRequest?.BankName</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted small">Số tài khoản:</span>
                        <span class=" small">@Model.RefundRequest?.AccountNumber</span>
                    </div>
                </div>

                <div class="alert alert-success border-0 bg-opacity-10 bg-success text-success small mb-4">
                    <i class="bi bi-info-circle me-2"></i>
                    Tiền sẽ được cộng vào tài khoản của bạn trong ít phút tùy theo quy trình của ngân hàng.
                </div>

                <div class="d-grid">
                    <a href="/" class="ac-btn-primary py-3 rounded-pill text-decoration-none">
                        Quay lại Trang chủ
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
