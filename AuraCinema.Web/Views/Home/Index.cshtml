@model AuraCinema.Web.ViewModels.Home.HomeViewModel
@{
    ViewData["Title"] = "Trang chủ";
    ViewData["Description"] = "Aura Cinema - Hệ thống đặt vé xem phim trực tuyến";
}

<!-- ═══ HERO SECTION ═══ -->
<section class="ac-hero">
    <div class="ac-hero-bg"></div>
    <div class="container position-relative" style="z-index:2;">
        <div class="row align-items-center min-vh-75 py-5">
            <div class="col-lg-6">
                <span class="ac-badge mb-3">🎬 RẠP PHIM SỐ 1</span>
                <h1 class="ac-hero-title">
                    Trải nghiệm<br/>
                    <span class="ac-gradient-text">Điện ảnh</span><br/>
                    Đỉnh cao
                </h1>
                <p class="ac-hero-desc mt-3 mb-4">
                    Đặt vé dễ dàng, thanh toán nhanh chóng. Tận hưởng những bộ phim
                    bom tấn với chất lượng hình ảnh và âm thanh tuyệt vời nhất.
                </p>
                <div class="d-flex gap-3 flex-wrap">
                    <a asp-controller="Movies" asp-action="Index"
                       class="ac-btn-primary px-5 py-3">
                        <i class="bi bi-play-fill"></i>Xem phim ngay
                    </a>
                    <a asp-controller="Promotions" asp-action="Index"
                       class="ac-btn-outline px-4 py-3">
                        <i class="bi bi-gift"></i>Ưu đãi
                    </a>
                </div>

                <!-- Stats -->
                <div class="d-flex gap-4 mt-5">
                    <div>
                        <div class="ac-stat-number">@Model.NowShowing.Count+</div>
                        <div class="ac-stat-label">Phim đang chiếu</div>
                    </div>
                    <div class="ac-stat-divider"></div>
                    <div>
                        <div class="ac-stat-number">3</div>
                        <div class="ac-stat-label">Phòng chiếu</div>
                    </div>
                    <div class="ac-stat-divider"></div>
                    <div>
                        <div class="ac-stat-number">300</div>
                        <div class="ac-stat-label">Ghế ngồi</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 d-none d-lg-block">
                <div class="ac-hero-cards">
                    @if (Model.FeaturedMovies.Any())
                    {
                        var featuredMovies = Model.FeaturedMovies.Take(5).ToList();
                        <div class="carousel-3d" id="heroCarousel3d">
                            @for (int i = 0; i < featuredMovies.Count; i++)
                            {
                                var hero = featuredMovies[i];
                                <div class="item-3d" data-index="@i">
                                    <a asp-controller="Movies" asp-action="Details" asp-route-id="@hero.MovieID" class="text-decoration-none d-block h-100">
                                        <img src="@hero.Poster" alt="@hero.Title" onerror="this.src='/images/placeholder-movie.jpg'" />
                                    </a>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <style>
        .carousel-3d {
            position: relative;
            width: 100%;
            height: 540px;
            display: flex;
            justify-content: center;
            align-items: center;
            perspective: 1200px;
            transform-style: preserve-3d;
        }
        .item-3d {
            position: absolute;
            width: 340px;
            aspect-ratio: 2/3;
            transition: all 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 20px 50px rgba(0,0,0,0.5);
            cursor: pointer;
        }
        .item-3d img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .item-3d.active {
            transform: translateX(0) translateZ(0) scale(1);
            z-index: 3;
            opacity: 1;
            box-shadow: 0 40px 80px rgba(0,0,0,0.8);
        }
        .item-3d.prev {
            transform: translateX(-180px) translateZ(-100px) scale(0.85);
            z-index: 2;
            opacity: 0.8;
            filter: brightness(0.5);
        }
        .item-3d.next {
            transform: translateX(180px) translateZ(-100px) scale(0.85);
            z-index: 2;
            opacity: 0.8;
            filter: brightness(0.5);
        }
        .item-3d.hidden {
            transform: translateX(0) translateZ(-200px) scale(0.5);
            z-index: 1;
            opacity: 0;
            pointer-events: none;
        }
    </style>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const items = document.querySelectorAll('.item-3d');
            if (items.length === 0) return;
            
            let currentIndex = 0;
            const totalItems = items.length;

            function updateCarousel() {
                items.forEach((item, index) => {
                    item.className = 'item-3d'; // reset
                    if (index === currentIndex) {
                        item.classList.add('active');
                    } else if (index === (currentIndex - 1 + totalItems) % totalItems) {
                        item.classList.add('prev');
                    } else if (index === (currentIndex + 1) % totalItems) {
                        item.classList.add('next');
                    } else {
                        item.classList.add('hidden');
                    }
                });
            }

            updateCarousel();

            setInterval(() => {
                currentIndex = (currentIndex + 1) % totalItems;
                updateCarousel();
            }, 3000);

            // Cho phép click để chọn prev/next
            items.forEach((item, index) => {
                item.addEventListener('click', (e) => {
                    if (!item.classList.contains('active')) {
                        e.preventDefault();
                        currentIndex = index;
                        updateCarousel();
                    }
                });
            });
        });
    </script>
}

<!-- ═══ PHIM ĐANG CHIẾU ═══ -->
@if (Model.NowShowing.Any())
{
<section class="ac-section">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="ac-section-title">
                    <span class="ac-dot ac-dot-live"></span>Phim đang chiếu
                </h2>
                <p class="ac-section-subtitle">Những bộ phim hay nhất đang có ở rạp</p>
            </div>
            <a asp-controller="Movies" asp-action="Index" asp-route-status="Dang chieu"
               class="ac-btn-outline btn-sm px-3">
                Xem tất cả <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
        <div class="row g-4">
            @foreach (var movie in Model.NowShowing.Take(8))
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <partial name="_MovieCard" model="movie" />
                </div>
            }
        </div>
    </div>
</section>
}

<!-- ═══ VÉ CỦA TÔI (GẦN ĐÂY) ═══ -->
@if (Model.RecentTickets != null && Model.RecentTickets.Any())
{
<section class="ac-section pt-0">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="ac-section-title">Vé của bạn</h2>
                <p class="ac-section-subtitle">Những suất chiếu sắp tới</p>
            </div>
            <a asp-controller="MyTickets" asp-action="Index" class="ac-btn-outline btn-sm px-3">
                Xem tất cả <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
        <div class="row g-3">
            @foreach (var ticket in Model.RecentTickets)
            {
                <div class="col-md-6 col-lg-4">
                    <a asp-controller="MyTickets" asp-action="Detail" asp-route-id="@ticket.OrderID" class="text-decoration-none">
                        <div class="ac-card p-3 border-ac hover-scale d-flex gap-3">
                            <img src="@ticket.Poster" alt="@ticket.MovieTitle" class="rounded" style="width: 60px; height: 90px; object-fit: cover;" onerror="this.src='/images/placeholder-movie.jpg'" />
                            <div class="flex-grow-1 overflow-hidden">
                                <h6 class=" fw-bold mb-1 text-truncate">@ticket.MovieTitle</h6>
                                <p class="text-muted small mb-1">@ticket.Showtime.ToString("HH:mm - dd/MM")</p>
                                <p class="ac-badge m-0" style="font-size: 0.7rem;">@ticket.RoomName &bull; @ticket.SeatList</p>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
</section>
}

<!-- ═══ PHIM SẮP CHIẾU ═══ -->
@if (Model.ComingSoon.Any())
{
<section class="ac-section" style="background: var(--ac-surface);">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="ac-section-title">
                    <span class="ac-dot ac-dot-soon"></span>Sắp chiếu
                </h2>
                <p class="ac-section-subtitle">Đang chờ đợi và sẵn sàng</p>
            </div>
            <a asp-controller="Movies" asp-action="Index" asp-route-status="Sap chieu"
               class="ac-btn-outline btn-sm px-3">
                Xem tất cả <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
        <div class="row g-4">
            @foreach (var movie in Model.ComingSoon.Take(4))
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <partial name="_MovieCard" model="movie" />
                </div>
            }
        </div>
    </div>
</section>
}

<!-- ═══ CTA ═══ -->
<section class="ac-cta-section">
    <div class="container text-center py-5">
        <h2 class="ac-section-title mb-3">Sẵn sàng cho buổi xem phim?</h2>
        <p style="color:var(--ac-text);max-width:500px;margin:auto;" class="mb-4">
            Đăng ký tài khoản để đặt vé nhanh chóng và nhận nhiều ưu đãi hấp dẫn.
        </p>
        @if (!(User.Identity?.IsAuthenticated == true))
        {
            <a asp-controller="Account" asp-action="Register"
               class="ac-btn-primary px-5 py-3">
                <i class="bi bi-person-plus"></i>Tạo tài khoản miễn phí
            </a>
        }
    </div>
</section>
