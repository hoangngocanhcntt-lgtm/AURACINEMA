@model AuraCinema.Web.ViewModels.Home.HomeViewModel
@{
    ViewData["Title"] = "Trang chu";
    ViewData["Description"] = "Aura Cinema - He thong dat ve xem phim truc tuyen";
}

<!-- ═══ HERO SECTION ═══ -->
<section class="ac-hero">
    <div class="ac-hero-bg"></div>
    <div class="container position-relative" style="z-index:2;">
        <div class="row align-items-center min-vh-75 py-5">
            <div class="col-lg-6">
                <span class="ac-badge mb-3">🎬 RAP PHIM SO 1</span>
                <h1 class="ac-hero-title">
                    Trai nghiem<br/>
                    <span class="ac-gradient-text">Dien anh</span><br/>
                    Dinh cao
                </h1>
                <p class="ac-hero-desc mt-3 mb-4">
                    Dat ve de dang, thanh toan nhanh chong. Tan huong nhung bo phim
                    bom tan voi chat luong hinh anh va am thanh tuyet voi nhat.
                </p>
                <div class="d-flex gap-3 flex-wrap">
                    <a asp-controller="Movies" asp-action="Index"
                       class="ac-btn-primary px-5 py-3">
                        <i class="bi bi-play-fill"></i>Xem phim ngay
                    </a>
                    <a asp-controller="Promotions" asp-action="Index"
                       class="ac-btn-outline px-4 py-3">
                        <i class="bi bi-gift"></i>Uu dai
                    </a>
                </div>

                <!-- Stats -->
                <div class="d-flex gap-4 mt-5">
                    <div>
                        <div class="ac-stat-number">@Model.NowShowing.Count+</div>
                        <div class="ac-stat-label">Phim dang chieu</div>
                    </div>
                    <div class="ac-stat-divider"></div>
                    <div>
                        <div class="ac-stat-number">3</div>
                        <div class="ac-stat-label">Phong chieu</div>
                    </div>
                    <div class="ac-stat-divider"></div>
                    <div>
                        <div class="ac-stat-number">300</div>
                        <div class="ac-stat-label">Ghe ngoi</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 d-none d-lg-block">
                <div class="ac-hero-cards">
                    @if (Model.FeaturedMovies.Any())
                    {
                        var hero = Model.FeaturedMovies.First();
                        <a asp-controller="Movies" asp-action="Details" asp-route-id="@hero.MovieID" class="text-decoration-none">
                            <div class="ac-hero-poster">
                                <img src="@hero.Poster" alt="@hero.Title"
                                     onerror="this.src='/images/placeholder-movie.jpg'" />
                                <div class="ac-hero-poster-overlay">
                                    <span class="badge ac-badge-live">DANG CHIEU</span>
                                    <h4>@hero.Title</h4>
                                    <p>@hero.Genre &bull; @hero.Duration phut</p>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══ PHIM ĐANG CHIẾU ═══ -->
@if (Model.NowShowing.Any())
{
<section class="ac-section">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="ac-section-title">
                    <span class="ac-dot ac-dot-live"></span>Phim dang chieu
                </h2>
                <p class="ac-section-subtitle">Nhung bo phim hay nhat dang co o rap</p>
            </div>
            <a asp-controller="Movies" asp-action="Index" asp-route-status="Dang chieu"
               class="ac-btn-outline btn-sm px-3">
                Xem tat ca <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
        <div class="row g-4">
            @foreach (var movie in Model.NowShowing.Take(8))
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <partial name="_MovieCard" model="movie" />
                </div>
            }
        </div>
    </div>
</section>
}

<!-- ═══ VÉ CỦA TÔI (GẦN ĐÂY) ═══ -->
@if (Model.RecentTickets != null && Model.RecentTickets.Any())
{
<section class="ac-section pt-0">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="ac-section-title">Ve cua ban</h2>
                <p class="ac-section-subtitle">Nhung suat chieu sap toi</p>
            </div>
            <a asp-controller="MyTickets" asp-action="Index" class="ac-btn-outline btn-sm px-3">
                Xem tat ca <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
        <div class="row g-3">
            @foreach (var ticket in Model.RecentTickets)
            {
                <div class="col-md-6 col-lg-4">
                    <a asp-controller="MyTickets" asp-action="Detail" asp-route-id="@ticket.OrderID" class="text-decoration-none">
                        <div class="ac-card p-3 border-ac hover-scale d-flex gap-3">
                            <img src="@ticket.Poster" alt="@ticket.MovieTitle" class="rounded" style="width: 60px; height: 90px; object-fit: cover;" onerror="this.src='/images/placeholder-movie.jpg'" />
                            <div class="flex-grow-1 overflow-hidden">
                                <h6 class="text-white fw-bold mb-1 text-truncate">@ticket.MovieTitle</h6>
                                <p class="text-muted small mb-1">@ticket.Showtime.ToString("HH:mm - dd/MM")</p>
                                <p class="ac-badge m-0" style="font-size: 0.7rem;">@ticket.RoomName &bull; @ticket.SeatList</p>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
</section>
}

<!-- ═══ PHIM SẮP CHIẾU ═══ -->
@if (Model.ComingSoon.Any())
{
<section class="ac-section" style="background: var(--ac-surface);">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="ac-section-title">
                    <span class="ac-dot ac-dot-soon"></span>Sap chieu
                </h2>
                <p class="ac-section-subtitle">Dang cho doi va san sang</p>
            </div>
            <a asp-controller="Movies" asp-action="Index" asp-route-status="Sap chieu"
               class="ac-btn-outline btn-sm px-3">
                Xem tat ca <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
        <div class="row g-4">
            @foreach (var movie in Model.ComingSoon.Take(4))
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <partial name="_MovieCard" model="movie" />
                </div>
            }
        </div>
    </div>
</section>
}

<!-- ═══ CTA ═══ -->
<section class="ac-cta-section">
    <div class="container text-center py-5">
        <h2 class="ac-section-title mb-3">San sang cho buoi xem phim?</h2>
        <p style="color:var(--ac-muted);max-width:500px;margin:auto;" class="mb-4">
            Dang ky tai khoan de dat ve nhanh chong va nhan nhieu uu dai hap dan.
        </p>
        @if (!(User.Identity?.IsAuthenticated == true))
        {
            <a asp-controller="Account" asp-action="Register"
               class="ac-btn-primary px-5 py-3">
                <i class="bi bi-person-plus"></i>Tao tai khoan mien phi
            </a>
        }
    </div>
</section>
