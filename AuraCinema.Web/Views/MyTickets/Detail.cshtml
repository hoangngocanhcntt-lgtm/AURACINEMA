@model AuraCinema.Web.ViewModels.MyTickets.TicketDetailViewModel
@{
    ViewData["Title"] = "Chi tiết vé";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container pt-5 pb-5">
    <div class="mb-4">
        <a asp-action="Index" class="text-muted text-decoration-none"><i class="bi bi-arrow-left me-2"></i>Quay lại danh sách vé</a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="ac-card p-0 overflow-hidden shadow-lg border-0" style="border-radius: 16px;">
                <div class="row g-0">
                    <!-- TICKET INFO -->
                    <div class="col-md-7 p-4 p-md-5 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-4">
                            <div>
                                <h4 class="fw-bold  mb-1">@Model.MovieTitle</h4>
                                <span class="ac-badge px-2 py-1">@Model.RoomName</span>
                            </div>
                            @if (Model.Status == "Đã thanh toán")
                            {
                                <span class="badge bg-success bg-opacity-25 text-success border border-success px-3 py-2 rounded-pill">Đã thanh toán</span>
                            }
                            else if (Model.Status == "Chờ thanh toán")
                            {
                                <span class="badge bg-warning bg-opacity-25 text-warning border border-warning px-3 py-2 rounded-pill">Chờ thanh toán</span>
                            }
                            else if (Model.Status == "Đã sử dụng")
                            {
                                <span class="badge bg-secondary bg-opacity-25 text-secondary border border-secondary px-3 py-2 rounded-pill">Đã sử dụng</span>
                            }
                            else if (Model.Status == "Cần hoàn tiền")
                            {
                                <span class="badge bg-info bg-opacity-25 text-info border border-info px-3 py-2 rounded-pill">Cần hoàn tiền</span>
                            }
                            else if (Model.Status == "Đã hoàn tiền")
                            {
                                <span class="badge bg-primary bg-opacity-25 text-primary border border-primary px-3 py-2 rounded-pill">Đã hoàn tiền</span>
                            }
                            else
                            {
                                <span class="badge bg-danger bg-opacity-25 text-danger border border-danger px-3 py-2 rounded-pill">Đã hủy</span>
                            }
                        </div>

                        <div class="row g-4 flex-grow-1">
                            <div class="col-6">
                                <p class="text-muted small mb-1">Ngày giờ chiếu</p>
                                <h6 class="fw-bold ">@Model.Showtime.ToString("HH:mm")<br/>@Model.Showtime.ToString("dd/MM/yyyy")</h6>
                            </div>
                            <div class="col-6">
                                <p class="text-muted small mb-1">Ghế ngồi</p>
                                <h6 class="fw-bold ">@Model.SeatList</h6>
                            </div>
                            <div class="col-6">
                                <p class="text-muted small mb-1">Mã đơn hàng</p>
                                <h6 class="fw-bold ">#@Model.OrderCode</h6>
                            </div>
                            <div class="col-6">
                                <p class="text-muted small mb-1">Ngày đặt</p>
                                <h6 class="fw-bold ">@Model.CreatedAt.ToString("HH:mm dd/MM/yyyy")</h6>
                            </div>
                        </div>

                        @if (Model.ServiceList != null && Model.ServiceList.Any())
                        {
                            <div class="mt-3">
                                <p class="text-muted small mb-1">Dịch vụ đi kèm</p>
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var svc in Model.ServiceList)
                                    {
                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-2 py-1 fw-normal">@svc</span>
                                    }
                                </div>
                            </div>
                        }

                        <div class="mt-4 pt-4 border-top border-ac">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Giá vé:</span>
                                <span>@Model.BaseAmount.ToString("N0")đ</span>
                            </div>
                            @if (Model.Discount > 0)
                            {
                                <div class="d-flex justify-content-between mb-2 text-success">
                                    <span>Khuyến mãi (@Model.PromotionTitle):</span>
                                    <span>-@Model.Discount.ToString("N0")đ</span>
                                </div>
                            }
                            <div class="d-flex justify-content-between pt-2 border-top border-ac border-opacity-50">
                                <span class="text-muted">Tổng cộng:</span>
                                <span class="fw-bold text-primary-ac fs-5">@Model.FinalAmount.ToString("N0")đ</span>
                            </div>
                        </div>
                        
                        @if (Model.Status == "Cho thanh toan")
                        {
                            <div class="mt-4">
                                <a asp-controller="Booking" asp-action="Checkout" asp-route-orderId="@Model.OrderID" class="ac-btn-primary w-100 text-center py-2 d-block">Thanh toán ngay</a>
                            </div>
                        }
                    </div>

                    <!-- QR CODE SECTION -->
                    <div class="col-md-5 bg-surface border-start border-ac d-flex flex-column justify-content-center align-items-center p-4 p-md-5 position-relative">
                        <!-- Perforation visual effect -->
                        <div style="position: absolute; left: -10px; top: 0; bottom: 0; width: 20px; background-image: radial-gradient(circle at 10px, transparent 6px, var(--ac-surface) 7px); background-size: 20px 24px; background-position: 0 0; background-repeat: repeat-y; z-index: 10;" class="d-none d-md-block"></div>
                        <div style="position: absolute; left: -10px; top: 0; bottom: 0; width: 10px; background: var(--ac-bg); z-index: 9;" class="d-none d-md-block"></div>
                        
                        <img src="@Model.Poster" alt="@Model.MovieTitle" class="rounded mb-4 shadow" style="width: 120px; height: 180px; object-fit: cover; opacity: 0.9;" onerror="this.src='/images/placeholder-movie.jpg'" />
                        
                        @if (Model.Status == "Đã thanh toán" && !string.IsNullOrEmpty(Model.QrCodeBase64))
                        {
                            <div class="bg-white p-2 rounded shadow-sm">
                                <img src="data:image/png;base64,@Model.QrCodeBase64" alt="QR Code" style="width: 150px; height: 150px;" />
                            </div>
                            <p class="text-muted small mt-3 mb-0 text-center">Đưa mã QR này cho nhân viên khi đến rạp</p>
                        }
                        else if (Model.Status == "Chờ thanh toán")
                        {
                            <div class="text-center">
                                <i class="bi bi-qr-code text-muted mb-2" style="font-size: 3rem; opacity: 0.2;"></i>
                                <p class="text-muted small mb-0">Mã QR sẽ hiển thị sau khi thanh toán</p>
                            </div>
                        }
                        else if (Model.Status == "Đã sử dụng")
                        {
                            <div class="text-center">
                                <i class="bi bi-check2-circle text-secondary mb-2" style="font-size: 4rem;"></i>
                                <p class="text-secondary fw-bold mb-0">Vé đã sử dụng</p>
                            </div>
                        }
                        else if (Model.Status == "Cần hoàn tiền")
                        {
                            <div class="text-center">
                                <i class="bi bi-arrow-counterclockwise text-info mb-2" style="font-size: 3rem; opacity: 0.6;"></i>
                                <p class="text-info small mb-0">Đang chờ hoàn tiền</p>
                            </div>
                        }
                        else if (Model.Status == "Đã hoàn tiền")
                        {
                            <div class="text-center">
                                <i class="bi bi-check2-circle text-primary mb-2" style="font-size: 4rem;"></i>
                                <p class="text-primary fw-bold mb-0">Đã hoàn tiền thành công</p>
                            </div>
                        }
                        else
                        {
                            <div class="text-center">
                                <i class="bi bi-x-circle text-danger mb-2" style="font-size: 3rem; opacity: 0.5;"></i>
                                <p class="text-muted small mb-0">Vé đã bị hủy</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
