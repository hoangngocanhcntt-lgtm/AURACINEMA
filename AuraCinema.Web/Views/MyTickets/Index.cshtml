@model List<AuraCinema.Web.ViewModels.MyTickets.TicketItemViewModel>
@{
    ViewData["Title"] = "Vé của tôi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container pt-5 pb-5">
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h2 class="fw-bold  mb-0"><i class="bi bi-ticket-perforated me-2 text-primary-ac"></i>Lịch sử đặt vé</h2>
            <p class="text-muted mt-2">Quản lý các vé xem phim của bạn tại Aura Cinema</p>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="ac-card p-5 text-center">
            <i class="bi bi-ticket-detailed text-muted mb-3" style="font-size: 3rem;"></i>
            <h5 class="">Bạn chưa có vé nào</h5>
            <p class="text-muted mb-4">Hãy chọn một bộ phim thật hay và đặt vé ngay nhé!</p>
            <a asp-controller="Movies" asp-action="Index" class="ac-btn-primary px-4 py-2">Xem lịch chiếu ngay</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var ticket in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="ac-card p-0 overflow-hidden h-100 d-flex flex-column" style="transition: transform 0.2s; cursor: pointer;" onclick="location.href='@Url.Action("Detail", "MyTickets", new { id = ticket.OrderID })'">
                        <div class="d-flex p-3 border-bottom border-ac">
                            <img src="@ticket.Poster" alt="@ticket.MovieTitle" class="rounded" style="width: 70px; height: 100px; object-fit: cover;" onerror="this.src='/images/placeholder-movie.jpg'" />
                            <div class="ms-3 flex-grow-1">
                                <h6 class="fw-bold  mb-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">@ticket.MovieTitle</h6>
                                <p class="text-muted small mb-1"><i class="bi bi-calendar-event me-1"></i>@ticket.Showtime.ToString("HH:mm - dd/MM/yyyy")</p>
                                <p class="ac-badge m-0 px-2 py-1" style="font-size: 0.7rem;">@ticket.RoomName</p>
                            </div>
                        </div>
                        <div class="p-3 bg-surface flex-grow-1">
                            <div class="d-flex justify-content-between mb-2 small">
                                <span class="text-muted">Mã đơn hàng:</span>
                                <span class="fw-bold ">#@ticket.OrderID</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2 small">
                                <span class="text-muted">Ghế:</span>
                                <span class="fw-bold ">@ticket.SeatList</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2 small">
                                <span class="text-muted">Tổng tiền:</span>
                                <span class="fw-bold text-primary-ac">@ticket.FinalAmount.ToString("N0")đ</span>
                            </div>
                            <div class="d-flex justify-content-between mt-3 pt-2 border-top border-ac small align-items-center">
                                <span class="text-muted">Trạng thái:</span>
                                @if (ticket.Status == "Đã thanh toán")
                                {
                                    <span class="badge bg-success bg-opacity-25 text-success border border-success"><i class="bi bi-check-circle me-1"></i>Thành công</span>
                                }
                                else if (ticket.Status == "Chờ thanh toán")
                                {
                                     <div class="d-flex flex-column align-items-end">
                                         <span class="badge bg-warning bg-opacity-25 text-warning border border-warning mb-2"><i class="bi bi-clock me-1"></i>Chờ thanh toán</span>
                                         @if (ticket.HoldExpiryTime > DateTime.Now)
                                         {
                                             <a href="@Url.Action("Checkout", "Booking", new { orderId = ticket.OrderID })" 
                                                class="btn btn-sm btn-primary py-1 px-3 rounded-pill" style="font-size: 0.7rem;" onclick="event.stopPropagation();">
                                                 <i class="bi bi-credit-card me-1"></i>Thanh toán ngay
                                             </a>
                                         }
                                     </div>
                                 }
                                else if (ticket.Status == "Đã sử dụng")
                                {
                                    <span class="badge bg-secondary bg-opacity-25 text-secondary border border-secondary"><i class="bi bi-check-all me-1"></i>Đã sử dụng</span>
                                }
                                else if (ticket.Status == "Cần hoàn tiền")
                                {
                                    <span class="badge bg-info bg-opacity-25 text-info border border-info"><i class="bi bi-arrow-counterclockwise me-1"></i>Cần hoàn tiền</span>
                                }
                                else if (ticket.Status == "Đã hoàn tiền")
                                {
                                    <span class="badge bg-primary bg-opacity-25 text-primary border border-primary"><i class="bi bi-check2-circle me-1"></i>Đã hoàn tiền</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-25 text-danger border border-danger"><i class="bi bi-x-circle me-1"></i>Đã hủy</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
