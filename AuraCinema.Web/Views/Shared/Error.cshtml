@using AuraCinema.Web.Models
@model ErrorViewModel
@{
    ViewData["Title"] = "Lỗi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="ac-auth-wrapper">
    <div class="ac-auth-card text-center">
        <div style="font-size:4rem;"><i class="bi bi-exclamation-triangle-fill text-warning"></i></div>
        <h1 class="ac-auth-title mt-3">Đã xảy ra lỗi</h1>
        @if (Model.ShowRequestId) {
            <p style="color:var(--ac-muted);font-size:0.85rem;">Request ID: <code>@Model.RequestId</code></p>
        }
        <a asp-controller="Home" asp-action="Index" class="ac-btn-primary mt-3">
            <i class="bi bi-house"></i>Về trang chủ
        </a>
    </div>
</div>
