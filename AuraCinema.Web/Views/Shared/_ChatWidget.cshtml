<div id="aura-chat-widget">
    <div id="aura-chat-bubble" onclick="toggleChat()">
        <i class="bi bi-chat-dots-fill"></i>
    </div>
    <div id="aura-chat-panel" class="d-none">
        <div class="aura-chat-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0" style="color: var(--aura-chat-text-dark);">Bé Aura 🎬</h5>
            <button class="btn-close" onclick="toggleChat()"></button>
        </div>
        <div id="aura-chat-messages">
            <!-- Messages will be rendered here -->
        </div>
        <div class="aura-chat-input d-flex">
            <input type="text" id="aura-chat-input-text" class="form-control" placeholder="Hỏi tớ gì đi..." onkeypress="handleChatKeyPress(event)">
            <button class="btn" id="aura-chat-send-btn" onclick="sendChatMessage()">
                <i class="bi bi-send-fill"></i>
            </button>
        </div>
    </div>
</div>
<link rel="stylesheet" href="~/css/chat-widget.css" />
<script src="~/js/chat-widget.js"></script>
