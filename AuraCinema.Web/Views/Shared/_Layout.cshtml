<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@ViewData["Description"]" />
    <title>@ViewData["Title"] — Aura Cinema</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/toast.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

<!-- ═══ NAVBAR ═══ -->
<nav class="navbar navbar-expand-lg ac-navbar" id="mainNavbar">
    <div class="container">
        <a class="navbar-brand ac-brand" asp-controller="Home" asp-action="Index">
            <span class="ac-logo-icon">🎬</span>
            <span class="ac-logo-text">AURA<span class="ac-logo-accent">CINEMA</span></span>
        </a>
        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navMain">
            <ul class="navbar-nav me-auto gap-1">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Movies" asp-action="Index">Phim</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Promotions" asp-action="Index">Khuyến mãi</a>
                </li>
            </ul>
            <ul class="navbar-nav gap-2 align-items-center">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="MyTickets" asp-action="Index">
                            <i class="bi bi-ticket-perforated me-1"></i>Vé của tôi
                        </a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#"
                           data-bs-toggle="dropdown" id="userMenu">
                            <div class="ac-avatar">@User.Identity.Name?.Substring(0,1).ToUpper()</div>
                            <span class="d-none d-lg-inline">@User.Identity.Name</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end ac-dropdown">
                            <li><h6 class="dropdown-header">@User.Identity.Name</h6></li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li>
                                    <a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                        <i class="bi bi-speedometer2 me-2"></i>Trang quản trị
                                    </a>
                                </li>
                            }
                            else if (User.IsInRole("Staff"))
                            {
                                <li>
                                    <a class="dropdown-item" asp-area="Admin" asp-controller="TicketScanner" asp-action="Index">
                                        <i class="bi bi-qr-code-scan me-2"></i>Quét vé
                                    </a>
                                </li>
                            }
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item text-danger">
                                        <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                    </li>
                    <li class="nav-item">
                        <a class="btn ac-btn-primary btn-sm px-4"
                           asp-controller="Account" asp-action="Register">Đăng ký</a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>


<!-- ═══ MAIN CONTENT ═══ -->
<main>
    @RenderBody()
</main>

<!-- ═══ FOOTER ═══ -->
<footer class="ac-footer mt-auto">
    <div class="container py-5">
        <div class="row g-4">
            <div class="col-lg-4">
                <div class="ac-brand mb-3">
                    <span class="ac-logo-icon">🎬</span>
                    <span class="ac-logo-text">AURA<span class="ac-logo-accent">CINEMA</span></span>
                </div>
                <p class="text-muted small">Trải nghiệm điện ảnh đỉnh cao. Đặt vé dễ dàng, thanh toán nhanh chóng.</p>
            </div>
            <div class="col-lg-2 col-6">
                <h6 class="fw-semibold mb-3" style="color: var(--ac-heading);">Khám phá</h6>
                <ul class="list-unstyled small text-muted">
                    <li class="mb-2"><a class="footer-link" asp-controller="Movies" asp-action="Index">Phim đang chiếu</a></li>
                    <li class="mb-2"><a class="footer-link" asp-controller="Promotions" asp-action="Index">Khuyến mãi</a></li>
                </ul>
            </div>
            <div class="col-lg-2 col-6">
                <h6 class="fw-semibold mb-3" style="color: var(--ac-heading);">Hỗ trợ</h6>
                <ul class="list-unstyled small text-muted">
                    <li class="mb-2"><a class="footer-link" href="#">Liên hệ</a></li>
                    <li class="mb-2"><a class="footer-link" href="#">Câu hỏi thường gặp</a></li>
                </ul>
            </div>
            <div class="col-lg-4">
                <h6 class="fw-semibold mb-3" style="color: var(--ac-heading);">Kết nối với chúng tôi</h6>
                <div class="d-flex gap-3">
                    <a href="#" class="ac-social-link"><i class="bi bi-facebook"></i></a>
                    <a href="#" class="ac-social-link"><i class="bi bi-instagram"></i></a>
                    <a href="#" class="ac-social-link"><i class="bi bi-youtube"></i></a>
                </div>
            </div>
        </div>
        <hr class="border-secondary mt-4 mb-3">
        <p class="text-center text-muted small mb-0">© 2025 Aura Cinema. All rights reserved.</p>
    </div>
</footer>

<!-- Scripts -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/toast.js" asp-append-version="true"></script>

<script>
    $(document).ready(function() {
        @if (TempData["Success"] != null) {
            <text>showToast('@Html.Raw(TempData["Success"])', 'success');</text>
        }
        @if (TempData["Error"] != null) {
            <text>showToast('@Html.Raw(TempData["Error"])', 'error');</text>
        }
        @if (TempData["Info"] != null) {
            <text>showToast('@Html.Raw(TempData["Info"])', 'info');</text>
        }
    });
</script>

<!-- Navbar scroll effect -->
<script>
    window.addEventListener('scroll', () => {
        const nav = document.getElementById('mainNavbar');
        nav.classList.toggle('scrolled', window.scrollY > 50);
    });
</script>

@await RenderSectionAsync("Scripts", required: false)
@await Html.PartialAsync("_ChatWidget")
</body>
</html>
