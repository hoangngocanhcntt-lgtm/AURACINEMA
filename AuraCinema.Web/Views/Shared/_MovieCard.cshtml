@model AuraCinema.Web.ViewModels.Home.MovieCardViewModel

<a asp-controller="Movies" asp-action="Details" asp-route-id="@Model.MovieID"
   class="text-decoration-none">
    <div class="ac-movie-card">
        <div class="ac-movie-poster">
            <img src="@Model.Poster" alt="@Model.Title"
                 onerror="this.src='/images/placeholder-movie.jpg'"
                 loading="lazy" />
            <div class="ac-movie-overlay">
                <div class="ac-play-btn">
                    <i class="bi bi-play-fill"></i>
                </div>
            </div>
            @if (Model.Status == "Dang chieu")
            {
                <span class="ac-movie-badge ac-badge-now">Đang chiếu</span>
            }
            else
            {
                <span class="ac-movie-badge ac-badge-coming">Sắp chiếu</span>
            }
        </div>
        <div class="ac-movie-info">
            <h6 class="ac-movie-title" title="@Model.Title">@Model.Title</h6>
            <div class="ac-movie-meta">
                <span><i class="bi bi-clock me-1"></i>@Model.Duration phút</span>
                <span class="mx-1">&bull;</span>
                <span>@Model.Genre.Split(',').FirstOrDefault()?.Trim()</span>
            </div>
        </div>
    </div>
</a>
